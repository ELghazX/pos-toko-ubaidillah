package categories

import (
	"fmt"
	repo "github.com/ELghazX/pos-toko-ubaidillah/internal/adapters/postgresql/sqlc"
	"github.com/ELghazX/pos-toko-ubaidillah/internal/views"
)

templ CategoryPage(categories []repo.Category) {
	@views.Base("Kategori Barang") {
		<h1>Kategori Barang</h1>
		<div x-data="{ open: false }">
			<button @click="open = true">
				Tambah Kategori
				<svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="vertical-align: middle;">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
				</svg>
			</button>
			<div
				x-show="open"
				style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 50;"
				x-transition
			>
				<div @click.outside="open = false" style="background: white; padding: 20px; border: 1px solid black; width: 300px;">
					<h2>Tambah Kategori Baru</h2>
					<form
						hx-post="/categories"
						hx-target="#category-table-container"
						hx-swap="outerHTML"
						@htmx:after-request.camel="if($event.detail.successful) open = false"
					>
						<div style="margin-bottom: 10px;">
							<label>Kode:</label>
							<br/>
							<input type="text" name="code" required/>
						</div>
						<div style="margin-bottom: 15px;">
							<label>Nama Kategori:</label>
							<br/>
							<input type="text" name="name" required/>
						</div>
						<button type="submit">Simpan</button>
						<button type="button" @click="open = false">Batal</button>
					</form>
				</div>
			</div>
		</div>
		<br/>
		@CategoryTable(categories)
	}
}

templ CategoryTable(categories []repo.Category) {
	<div id="category-table-container">
		<table border="1" cellpadding="5">
			<thead>
				<tr>
					<th>No</th>
					<th>Kode</th>
					<th>Nama</th>
					<th>Aksi</th>
				</tr>
			</thead>
			<tbody>
				for i, c := range categories {
					<tr x-data="{ openedit: false }">
						<th>{ i + 1 } </th>
						<td>{ c.Code }</td>
						<td>{ c.Name }</td>
						<td>
							<button @click="openedit = true">
								<svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"></path>
								</svg>
							</button>
							<button
								hx-delete={ "/categories/" + fmt.Sprint(c.ID) }
								hx-target="closest tr"
								hx-swap="outerHTML"
							>
								<svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"></path>
								</svg>
							</button>
							<div
								x-show="openedit"
								style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 50;"
								x-transition
							>
								<div @click.outside="openedit = false" style="background: white; padding: 20px; border: 1px solid black; width: 300px;">
									<h2>Ubah Kategori</h2>
									<form
										hx-put={ "/categories/" + fmt.Sprint(c.ID) }
										hx-target="#category-table-container"
										hx-swap="outerHTML"
										@htmx:after-request.camel="if($event.detail.successful) openedit = false"
									>
										<div style="margin-bottom: 10px;">
											<label>Kode:</label>
											<br/>
											<input type="text" value={ c.Code } name="code" required/>
										</div>
										<div style="margin-bottom: 15px;">
											<label>Nama Kategori:</label>
											<br/>
											<input type="text" value={ c.Name } name="name" required/>
										</div>
										<button type="submit">Simpan</button>
										<button type="button" @click="openedit = false">Batal</button>
									</form>
								</div>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
