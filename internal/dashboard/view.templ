			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
				<div class="bg-white rounded-2xl border border-[#E5E5EA] p-5 shadow-xs flex flex-col justify-between">
					<div class="flex items-center justify-between">
						<span class="text-xs font-semibold text-[#8E8E93] uppercase tracking-wider">Penjualan Hari Ini</span>
						<div class="w-9 h-9 rounded-xl bg-[#F5F5F7] flex items-center justify-center text-[#1D1D1F]">
							<svg class="w-5 h-5 text-[#8E8E93]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>
						</div>
					</div>
					<div class="mt-4">
						<div class="text-2xl font-bold text-[#1D1D1F] tracking-tight tabular-nums">
							Rp { utils.FormatRupiah(utils.FloatToNumeric(data.TodaySales)) }
						</div>
						<div class="flex items-center justify-between text-xs text-[#8E8E93] mt-1.5">
							<span>{ fmt.Sprint(data.TodayTransactions) } transaksi sukses</span>
							<a href="/sales" class="text-[#007AFF] hover:underline font-medium">Riwayat &rarr;</a>
						</div>
					</div>
				</div>
				<div class="bg-white rounded-2xl border border-[#E5E5EA] p-5 shadow-xs flex flex-col justify-between">
					<div class="flex items-center justify-between">
						<span class="text-xs font-semibold text-[#8E8E93] uppercase tracking-wider">Laba Kotor Hari Ini</span>
						<div class="w-9 h-9 rounded-xl bg-[#F5F5F7] flex items-center justify-center text-[#1D1D1F]">
							<svg class="w-5 h-5 text-[#8E8E93]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941"></path></svg>
						</div>
					</div>
					<div class="mt-4">
						<div class="text-2xl font-bold text-[#1D1D1F] tracking-tight tabular-nums">
							Rp { utils.FormatRupiah(utils.FloatToNumeric(data.TodayProfit)) }
						</div>
						<div class="text-xs text-[#8E8E93] mt-1.5 truncate">
							HPP / Modal: Rp { utils.FormatRupiah(utils.FloatToNumeric(data.TodayCOGS)) }
						</div>
					</div>
				</div>
				<div class="bg-white rounded-2xl border border-[#E5E5EA] p-5 shadow-xs flex flex-col justify-between">
					<div class="flex items-center justify-between">
						<span class="text-xs font-semibold text-[#8E8E93] uppercase tracking-wider">Total Kasbon Belum Lunas</span>
						<div class="w-9 h-9 rounded-xl bg-[#F5F5F7] flex items-center justify-center text-[#1D1D1F]">
							<svg class="w-5 h-5 text-[#8E8E93]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z"></path></svg>
						</div>
					</div>
					<div class="mt-4">
						<div class="text-2xl font-bold text-[#1D1D1F] tracking-tight tabular-nums">
							Rp { utils.FormatRupiah(utils.FloatToNumeric(data.TotalUnpaidDebt)) }
						</div>
						<div class="flex items-center justify-between text-xs text-[#8E8E93] mt-1.5">
