							<div class="p-3 bg-[#F5F5F7]/50 border border-[#E5E5EA] rounded-xl flex items-center justify-between gap-2">
								<div class="min-w-0">
									<p class="font-semibold text-xs text-[#1D1D1F] truncate">{ p.Name }</p>
									<p class="text-[11px] text-[#8E8E93] font-mono truncate">{ p.Sku }</p>
								</div>
								<div class="text-right flex-shrink-0">
									<span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold bg-[#FF3B30]/10 text-[#FF3B30] tabular-nums">
										{ fmt.Sprint(p.CurrentStock) } { p.UnitName }
									</span>
									<span class="block text-[10px] text-[#8E8E93] mt-0.5">Min: { fmt.Sprint(p.MinStock) }</span>
								</div>
							</div>
						}
					</div>
				</div>
			}
			<div class="bg-white rounded-2xl border border-[#E5E5EA] p-6 shadow-xs">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
					<div>
						<h2 class="text-lg font-bold text-[#1D1D1F]">Tren Penjualan 7 Hari Terakhir</h2>
						<p class="text-xs text-[#8E8E93] mt-0.5">Total omset kasir toko dalam seminggu</p>
					</div>
					<div class="flex items-center gap-2 text-xs text-[#8E8E93]">
						<span class="w-2.5 h-2.5 rounded-full bg-[#007AFF]"></span>
						<span class="font-medium text-[#1D1D1F]">Omset Penjualan</span>
						<span class="text-gray-400">• Arahkan kursor ke grafik untuk detail laba</span>
					</div>
				</div>
				<div class="h-56 flex items-end gap-3 sm:gap-6 pt-4 pb-2 border-b border-[#E5E5EA]">
					for _, day := range data.WeeklyTrend {
						<div class="flex-1 h-full flex flex-col justify-end items-center group relative">
							<div class="absolute bottom-full mb-2 hidden group-hover:flex flex-col items-center z-20 pointer-events-none">
								<div class="bg-[#1C1C1E]/95 backdrop-blur-md text-white text-[11px] rounded-xl px-3 py-2 shadow-xl whitespace-nowrap border border-white/10 space-y-0.5">
									<div class="font-bold text-gray-200">{ day.DayLabel }</div>
									<div class="text-[#007AFF] font-semibold tabular-nums">Omset: Rp { utils.FormatRupiah(day.TotalSales) }</div>
									<div class="text-gray-300 tabular-nums">Laba Kotor: Rp { utils.FormatRupiah(day.GrossProfit) }</div>
									<div class="text-gray-400 text-[10px]">{ fmt.Sprint(day.TotalTransactions) } Transaksi</div>
								</div>
								<div class="w-2 h-2 bg-[#1C1C1E] transform rotate-45 -mt-1"></div>
							</div>
							<div class="w-full max-w-[36px] h-full flex items-end justify-center">
								<div
									class="w-full bg-[#007AFF] rounded-t-lg transition-all duration-300 group-hover:bg-[#0066D6]"
									style={ fmt.Sprintf("height: %d%%", calcBarHeight(utils.NumericToFloat(day.TotalSales), getMaxSales(data))) }
