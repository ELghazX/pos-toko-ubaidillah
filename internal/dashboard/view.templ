							</div>
						</div>
						<a
							href="/products?stock_filter=low_stock"
							class="text-xs font-semibold px-3.5 min-h-[38px] inline-flex items-center justify-center rounded-xl border border-[#E5E5EA] bg-white text-[#1D1D1F] hover:bg-[#F5F5F7] transition shadow-xs self-start sm:self-auto whitespace-nowrap"
