							<span class="text-xs font-medium text-[#8E8E93] block truncate">{ day.DayLabel }</span>
							<span class="text-[10px] sm:text-[11px] font-bold text-[#1D1D1F] block mt-0.5 tabular-nums truncate px-0.5">
								Rp { utils.FormatRupiah(day.TotalSales) }
							</span>
						</div>
					}
				</div>
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
				<div class="lg:col-span-2 space-y-6">
					<div class="bg-white rounded-2xl border border-[#E5E5EA] overflow-hidden shadow-xs">
						<div class="px-6 py-4 border-b border-[#E5E5EA] flex items-center justify-between">
							<div>
								<h2 class="text-base font-bold text-[#1D1D1F]">Transaksi Penjualan Terkini</h2>
								<p class="text-xs text-[#8E8E93] mt-0.5">7 transaksi struk kasir terakhir</p>
							</div>
							<a href="/sales" class="text-xs font-semibold text-[#007AFF] hover:underline">
								Lihat Semua Riwayat &rarr;
							</a>
						</div>
						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse">
								<thead class="bg-[#F5F5F7]/70 text-[#8E8E93] text-sm border-b border-[#E5E5EA]">
									<tr>
										<th class="px-6 py-3.5 font-medium">No. Invoice</th>
										<th class="px-6 py-3.5 font-medium">Pelanggan</th>
										<th class="px-6 py-3.5 font-medium">Waktu</th>
										<th class="px-6 py-3.5 font-medium text-right">Total</th>
										<th class="px-6 py-3.5 font-medium text-center">Status</th>
										<th class="px-6 py-3.5 font-medium text-right">Aksi</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-[#E5E5EA] text-[15px]">
									for _, s := range data.RecentSales {
										<tr class="hover:bg-[#F5F5F7]/50 transition">
											<td class="px-6 py-3.5 font-mono font-bold text-[#007AFF]">
												<a href={ templ.SafeURL(fmt.Sprintf("/sales/%d", s.ID)) } class="hover:underline">
													{ s.InvoiceNo }
												</a>
											</td>
											<td class="px-6 py-3.5 font-medium text-[#1D1D1F]">
												{ s.CustomerName }
											</td>
											<td class="px-6 py-3.5 text-gray-600 text-sm">
												{ s.Date.Time.Local().Format("02 Jan 15:04") }
											</td>
											<td class="px-6 py-3.5 font-bold text-right text-[#1D1D1F] tabular-nums">
												Rp { utils.FormatRupiah(s.TotalAmount) }
											</td>
											<td class="px-6 py-3.5 text-center">
												if s.PaymentStatus == "kasbon" {
													<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-[#FF9500] border border-amber-200">
														Kasbon
													</span>
												} else {
													<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-50 text-[#34C759] border border-green-200 capitalize">
														{ s.PaymentMethod }
													</span>
												}
											</td>
											<td class="px-6 py-3.5 text-right">
												<a
													href={ templ.SafeURL(fmt.Sprintf("/sales/%d", s.ID)) }
													class="inline-flex items-center justify-center min-w-[36px] min-h-[36px] bg-[#F5F5F7] text-[#1D1D1F] hover:bg-[#E5E5EA] rounded-xl transition text-xs font-medium px-3"
												>
													Detail
												</a>
											</td>
										</tr>
									}
									if len(data.RecentSales) == 0 {
										<tr>
											<td colspan="6" class="px-6 py-8 text-center text-[#8E8E93]">
												Belum ada transaksi penjualan hari ini.
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
					<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
						<a
							href="/pos"
							class="bg-white border border-[#E5E5EA] p-4.5 rounded-2xl hover:border-[#D1D1D6] hover:bg-[#F5F5F7]/40 transition flex flex-col items-center text-center group shadow-2xs"
						>
							<div class="w-11 h-11 rounded-xl bg-[#F5F5F7] text-[#1D1D1F] flex items-center justify-center mb-2.5 group-hover:bg-[#E5E5EA] transition">
								<svg class="w-5 h-5 text-[#8E8E93] group-hover:text-[#1D1D1F] transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path></svg>
							</div>
							<span class="font-bold text-xs text-[#1D1D1F]">Layar Kasir</span>
							<span class="text-[11px] text-[#8E8E93] mt-0.5">Mulai Transaksi</span>
						</a>
						<a
							href="/debts"
							class="bg-white border border-[#E5E5EA] p-4.5 rounded-2xl hover:border-[#D1D1D6] hover:bg-[#F5F5F7]/40 transition flex flex-col items-center text-center group shadow-2xs"
						>
							<div class="w-11 h-11 rounded-xl bg-[#F5F5F7] text-[#1D1D1F] flex items-center justify-center mb-2.5 group-hover:bg-[#E5E5EA] transition">
								<svg class="w-5 h-5 text-[#8E8E93] group-hover:text-[#1D1D1F] transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"></path></svg>
							</div>
							<span class="font-bold text-xs text-[#1D1D1F]">Buku Kasbon</span>
							<span class="text-[11px] text-[#8E8E93] mt-0.5">Catat Pembayaran</span>
						</a>
						<a
							href="/goods-receipts"
							class="bg-white border border-[#E5E5EA] p-4.5 rounded-2xl hover:border-[#D1D1D6] hover:bg-[#F5F5F7]/40 transition flex flex-col items-center text-center group shadow-2xs"
						>
							<div class="w-11 h-11 rounded-xl bg-[#F5F5F7] text-[#1D1D1F] flex items-center justify-center mb-2.5 group-hover:bg-[#E5E5EA] transition">
								<svg class="w-5 h-5 text-[#8E8E93] group-hover:text-[#1D1D1F] transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3"></path></svg>
							</div>
							<span class="font-bold text-xs text-[#1D1D1F]">Terima Barang</span>
							<span class="text-[11px] text-[#8E8E93] mt-0.5">Kulakan Masuk</span>
						</a>
						<a
							href="/products/print-labels"
							class="bg-white border border-[#E5E5EA] p-4.5 rounded-2xl hover:border-[#D1D1D6] hover:bg-[#F5F5F7]/40 transition flex flex-col items-center text-center group shadow-2xs"
						>
							<div class="w-11 h-11 rounded-xl bg-[#F5F5F7] text-[#1D1D1F] flex items-center justify-center mb-2.5 group-hover:bg-[#E5E5EA] transition">
								<svg class="w-5 h-5 text-[#8E8E93] group-hover:text-[#1D1D1F] transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z"></path></svg>
							</div>
							<span class="font-bold text-xs text-[#1D1D1F]">Cetak Label</span>
							<span class="text-[11px] text-[#8E8E93] mt-0.5">Barcode &amp; Rak</span>
						</a>
					</div>
				</div>
				<div class="space-y-6">
					<div class="bg-white rounded-2xl border border-[#E5E5EA] p-5 shadow-xs">
						<div class="flex items-center justify-between pb-3 border-b border-[#E5E5EA] mb-3">
							<div>
								<h3 class="font-bold text-sm text-[#1D1D1F]">Produk Terlaris (7 Hari)</h3>
								<p class="text-[11px] text-[#8E8E93]">Barang paling diminati pelanggan</p>
							</div>
							<span class="text-xs font-semibold px-2 py-0.5 bg-[#F5F5F7] text-[#8E8E93] border border-[#E5E5EA] rounded-md">Top 5</span>
						</div>
						<div class="space-y-3">
							for i, p := range data.TopProducts {
								<div class="flex items-center justify-between gap-3 text-xs">
									<div class="flex items-center gap-2.5 min-w-0">
										<span class="w-6 h-6 rounded-full bg-[#F5F5F7] font-semibold text-xs flex items-center justify-center text-[#8E8E93] flex-shrink-0">
											{ fmt.Sprint(i + 1) }
										</span>
										<div class="min-w-0">
											<p class="font-semibold text-[#1D1D1F] truncate">{ p.ProductName }</p>
											<p class="text-[11px] text-[#8E8E93] truncate">{ p.CategoryName }</p>
										</div>
									</div>
									<div class="text-right flex-shrink-0">
										<span class="font-semibold text-[#1D1D1F] block">{ fmt.Sprint(p.TotalQtySold) } terjual</span>
										<span class="text-[11px] text-[#8E8E93] block tabular-nums">Rp { utils.FormatRupiah(p.TotalRevenue) }</span>
									</div>
								</div>
							}
							if len(data.TopProducts) == 0 {
								<p class="text-xs text-center text-[#8E8E93] py-4">Belum ada data produk terjual minggu ini.</p>
							}
						</div>
					</div>
					<div class="bg-white rounded-2xl border border-[#E5E5EA] p-5 shadow-xs">
						<div class="flex items-center gap-2.5 mb-3">
							<div class="w-8 h-8 rounded-xl bg-[#F5F5F7] flex items-center justify-center text-[#1D1D1F]">
								<svg class="w-4.5 h-4.5 text-[#8E8E93]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z"></path></svg>
							</div>
							<div>
								<h3 class="font-bold text-sm text-[#1D1D1F]">Pusat Piutang &amp; Kasbon</h3>
								<p class="text-[11px] text-[#8E8E93]">Kelola utang pelanggan &amp; tagihan</p>
							</div>
						</div>
						<div class="bg-[#F5F5F7]/60 rounded-xl p-3.5 border border-[#E5E5EA] space-y-2 mb-4 text-xs">
							<div class="flex justify-between items-center">
								<span class="text-[#8E8E93]">Total Piutang:</span>
								<span class="font-bold text-[#1D1D1F] tabular-nums">Rp { utils.FormatRupiah(utils.FloatToNumeric(data.TotalUnpaidDebt)) }</span>
							</div>
							<div class="flex justify-between items-center">
								<span class="text-[#8E8E93]">Pelanggan Berutang:</span>
								<span class="font-semibold text-[#1D1D1F]">{ fmt.Sprint(data.DebtCustomersCount) } Orang</span>
							</div>
							if data.OverdueDebt > 0 {
								<div class="flex justify-between items-center pt-1.5 border-t border-[#E5E5EA]">
									<span class="text-[#FF3B30] font-medium">Jatuh Tempo:</span>
									<span class="font-bold text-[#FF3B30] tabular-nums">Rp { utils.FormatRupiah(utils.FloatToNumeric(data.OverdueDebt)) }</span>
								</div>
							}
						</div>
						<a
							href="/debts"
							class="w-full min-h-[44px] rounded-xl border border-[#E5E5EA] bg-white hover:bg-[#F5F5F7] text-[#1D1D1F] text-xs font-semibold flex items-center justify-center gap-1.5 transition shadow-xs"
						>
							<span>Buka Buku Rekap Piutang</span>
							<svg class="w-4 h-4 text-[#8E8E93]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path></svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	}
}
