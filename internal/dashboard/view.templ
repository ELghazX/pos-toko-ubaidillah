package dashboard

import (
	"fmt"
	"github.com/ELghazX/pos-toko-ubaidillah/internal/utils"
	"github.com/ELghazX/pos-toko-ubaidillah/internal/views"
	"math"
)

func calcBarHeight(sales float64, maxSales float64) int {
	if maxSales <= 0 {
		return 8
	}
	h := int(math.Round((sales / maxSales) * 100))
	if h < 8 {
		return 8
	}
	if h > 100 {
		return 100
	}
	return h
}

func getMaxSales(data *DashboardData) float64 {
	var max float64 = 100000
	for _, day := range data.WeeklyTrend {
		s := utils.NumericToFloat(day.TotalSales)
		if s > max {
			max = s
		}
	}
	return max
}

templ DashboardPage(data *DashboardData) {
	@views.Base("Dashboard Toko", "dashboard") {
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
				<div>
					<h1 class="text-3xl font-bold text-[#1D1D1F] tracking-tight">Dashboard { data.CompanyName }</h1>
					<p class="text-sm text-[#8E8E93] mt-1">Pantau penjualan hari ini, estimasi laba, stok barang, dan piutang kasbon pelanggan</p>
				</div>
				<div class="flex flex-wrap items-center gap-2.5 sm:gap-3 w-full sm:w-auto">
					<a
						href="/debts"
						class="flex-1 sm:flex-none justify-center px-4 min-h-[44px] inline-flex items-center gap-2 rounded-xl border border-[#E5E5EA] bg-white text-sm font-semibold text-[#1D1D1F] hover:bg-[#F5F5F7] transition shadow-xs"
					>
						<svg class="w-4 h-4 text-[#8E8E93]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"></path></svg>
						<span>Buku Kasbon</span>
					</a>
					<a
						href="/pos"
						class="flex-1 sm:flex-none justify-center bg-[#007AFF] hover:bg-[#0066D6] text-white px-5 min-h-[44px] inline-flex items-center gap-2 rounded-xl text-sm font-semibold transition shadow-xs"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path></svg>
						<span>Buka Layar Kasir</span>
					</a>
