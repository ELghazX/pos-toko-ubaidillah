package settings

import (
	"encoding/json"
	"fmt"

	repo "github.com/ELghazX/pos-toko-ubaidillah/internal/adapters/postgresql/sqlc"
	"github.com/ELghazX/pos-toko-ubaidillah/internal/views"
)

func toJSON(v interface{}) string {
	b, err := json.Marshal(v)
	if err != nil {
		return `""`
	}
	return string(b)
}

templ CompanySettingsPage(cfg repo.GetCompanyConfigRow, successMsg string, errMsg string) {
	@views.Base("Profil & Pengaturan Toko", "settings") {
		<div
			class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8"
			x-data={ fmt.Sprintf(`{
				name: %s,
				tagline: %s,
				phone: %s,
				address: %s,
				footer: %s
			}`, toJSON(cfg.Name), toJSON(cfg.Tagline), toJSON(cfg.Phone), toJSON(cfg.Address), toJSON(cfg.ReceiptFooter)) }
		>
			<div class="mb-8">
				<div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#007AFF] mb-1">
					<span>Pengaturan Sistem</span>
				</div>
				<h1 class="text-2xl font-bold text-[#1D1D1F] tracking-tight">Profil & Informasi Toko</h1>
				<p class="text-sm text-[#8E8E93] mt-1">Kelola identitas usaha, kontak, dan format kepala serta catatan kaki struk penjualan kasir.</p>
			</div>

			if successMsg != "" {
				<div class="mb-6 p-4 rounded-2xl bg-green-50 border border-green-200 text-[#34C759] flex items-center gap-3 shadow-xs">
					<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
					<span class="text-sm font-semibold">{ successMsg }</span>
				</div>
			}

			if errMsg != "" {
				<div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-200 text-[#FF3B30] flex items-center gap-3 shadow-xs">
					<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					<span class="text-sm font-semibold">{ errMsg }</span>
				</div>
			}

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
				<form method="POST" action="/settings/company" class="lg:col-span-7 space-y-6">
					<div class="bg-white rounded-2xl shadow-xs border border-[#E5E5EA] p-6 space-y-4">
						<div class="border-b border-[#E5E5EA] pb-3">
							<h3 class="font-bold text-base text-[#1D1D1F]">Identitas Usaha</h3>
							<p class="text-xs text-[#8E8E93] mt-0.5">Nama dan bidang usaha yang merepresentasikan toko Anda</p>
						</div>

						<div>
							<label class="block text-xs font-semibold text-[#1D1D1F] mb-1.5">
								Nama Toko <span class="text-[#FF3B30]">*</span>
							</label>
							<input
								type="text"
								name="name"
								x-model="name"
								required
								placeholder="Contoh: Toko Ubaidillah"
								class="w-full bg-[#F5F5F7] border border-transparent rounded-xl px-3.5 min-h-[44px] text-sm text-[#1D1D1F] font-semibold focus:bg-white focus:border-[#007AFF] outline-none transition"
							/>
						</div>

						<div>
							<label class="block text-xs font-semibold text-[#1D1D1F] mb-1.5">
								Slogan / Keterangan Usaha
							</label>
							<input
								type="text"
								name="tagline"
								x-model="tagline"
								placeholder="Contoh: ATK & Layanan Fotocopy"
								class="w-full bg-[#F5F5F7] border border-transparent rounded-xl px-3.5 min-h-[44px] text-sm text-[#1D1D1F] focus:bg-white focus:border-[#007AFF] outline-none transition"
							/>
							<span class="text-[11px] text-[#8E8E93] mt-1 block">Ditampilkan tepat di bawah nama toko pada struk belanja.</span>
						</div>
					</div>

					<div class="bg-white rounded-2xl shadow-xs border border-[#E5E5EA] p-6 space-y-4">
						<div class="border-b border-[#E5E5EA] pb-3">
							<h3 class="font-bold text-base text-[#1D1D1F]">Kontak & Alamat</h3>
							<p class="text-xs text-[#8E8E93] mt-0.5">Nomor kontak dan lokasi fisik toko untuk pelanggan</p>
						</div>

						<div>
							<label class="block text-xs font-semibold text-[#1D1D1F] mb-1.5">
								Nomor Telepon / WhatsApp
							</label>
							<input
								type="text"
								name="phone"
								x-model="phone"
								placeholder="Contoh: 0812-3456-7890"
								class="w-full bg-[#F5F5F7] border border-transparent rounded-xl px-3.5 min-h-[44px] text-sm text-[#1D1D1F] focus:bg-white focus:border-[#007AFF] outline-none transition"
							/>
						</div>

						<div>
							<label class="block text-xs font-semibold text-[#1D1D1F] mb-1.5">
								Alamat Lengkap Toko
							</label>
							<textarea
								name="address"
								x-model="address"
								rows="3"
								placeholder="Contoh: Jl. Sudirman No. 45, Jakarta Pusat"
								class="w-full bg-[#F5F5F7] border border-transparent rounded-xl p-3.5 text-sm text-[#1D1D1F] focus:bg-white focus:border-[#007AFF] outline-none transition resize-none"
							></textarea>
						</div>
					</div>

					<div class="bg-white rounded-2xl shadow-xs border border-[#E5E5EA] p-6 space-y-4">
						<div class="border-b border-[#E5E5EA] pb-3">
							<h3 class="font-bold text-base text-[#1D1D1F]">Pesan & Catatan Kaki Struk</h3>
							<p class="text-xs text-[#8E8E93] mt-0.5">Teks penutup yang dicetak di bagian paling bawah struk pembayaran</p>
						</div>

						<div>
							<label class="block text-xs font-semibold text-[#1D1D1F] mb-1.5">
								Catatan Kaki (Receipt Footer)
							</label>
							<textarea
								name="receipt_footer"
								x-model="footer"
								rows="3"
								placeholder="Contoh: Terima Kasih Atas Kunjungan Anda!&#10;Barang yang dibeli tidak dapat ditukar/dikembalikan"
								class="w-full bg-[#F5F5F7] border border-transparent rounded-xl p-3.5 text-sm text-[#1D1D1F] focus:bg-white focus:border-[#007AFF] outline-none transition resize-none font-mono text-xs"
							></textarea>
							<span class="text-[11px] text-[#8E8E93] mt-1 block">Gunakan baris baru (Enter) untuk memisahkan baris teks ucapan terima kasih / kebijakan toko.</span>
						</div>
					</div>

					<div class="flex justify-end pt-2">
						<button
							type="submit"
							class="w-full sm:w-auto min-h-[46px] px-6 rounded-xl bg-[#007AFF] hover:bg-[#0066D6] text-white font-bold text-sm inline-flex items-center justify-center gap-2 shadow-xs transition"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
							<span>Simpan Perubahan Profil</span>
						</button>
					</div>
				</form>

				<div class="lg:col-span-5 lg:sticky lg:top-6 space-y-3">
					<div class="flex items-center justify-between px-1">
						<span class="text-xs font-bold uppercase tracking-wider text-[#8E8E93]">Pratinjau Struk (Live Preview)</span>
						<span class="text-[11px] text-[#007AFF] font-medium">Kertas 80mm</span>
					</div>

					<div class="bg-white rounded-2xl shadow-lg border border-[#E5E5EA] p-6 text-black font-mono text-xs space-y-3">
						<div class="text-center space-y-1">
							<div class="font-bold text-sm tracking-wide uppercase" x-text="name || 'NAMA TOKO'"></div>
							<div class="text-[11px] text-gray-700" x-text="tagline" x-show="tagline"></div>
							<div class="text-[10px] text-gray-600 leading-tight" x-text="address" x-show="address"></div>
							<div class="text-[10px] text-gray-700" x-text="'Telp: ' + phone" x-show="phone"></div>
						</div>

						<div class="border-t border-dashed border-black"></div>

						<div class="space-y-0.5 text-[11px]">
							<div class="flex justify-between">
								<span>Nota:</span>
								<span class="font-bold">TRX-20261017-0001</span>
							</div>
							<div class="flex justify-between">
								<span>Tgl:</span>
								<span>17/10/2026 10:30</span>
							</div>
							<div class="flex justify-between">
								<span>Pelanggan:</span>
								<span>Pelanggan Umum</span>
							</div>
						</div>

						<div class="border-t border-dashed border-black"></div>

						<div class="space-y-1 text-[11px]">
							<div>
								<div class="font-bold">Buku Tulis Sinar Dunia</div>
								<div class="flex justify-between pl-2">
									<span>1 Pack x 42.000</span>
									<span>42.000</span>
								</div>
							</div>
							<div>
								<div class="font-bold">Fotokopi A4 Hitam Putih</div>
								<div class="flex justify-between pl-2">
									<span>5 Lembar</span>
									<span>1.250</span>
								</div>
							</div>
						</div>

						<div class="border-t border-dashed border-black"></div>

						<div class="space-y-0.5 text-[11px]">
							<div class="flex justify-between font-bold text-xs">
								<span>TOTAL:</span>
								<span>Rp 43.250</span>
							</div>
							<div class="flex justify-between">
								<span>Bayar (tunai):</span>
								<span>50.000</span>
							</div>
							<div class="flex justify-between">
								<span>Kembali:</span>
								<span>6.750</span>
							</div>
						</div>

						<div class="border-t-2 border-dashed border-black"></div>

						<div class="text-center text-[10px] text-gray-700 whitespace-pre-line leading-relaxed" x-text="footer || 'Terima Kasih Atas Kunjungan Anda!'"></div>
					</div>
				</div>
			</div>
		</div>
	}
}
