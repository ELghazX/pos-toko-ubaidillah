package whatsapp

import "github.com/ELghazX/pos-toko-ubaidillah/internal/views"

templ WhatsAppSettingsPage(status StatusResponse) {
	@views.Base("Integrasi WhatsApp", "whatsapp") {
		<div
			x-data="{
				connected: false,
				phone: '',
				pushName: '',
				qrCode: '',
				statusText: '',
				testPhone: '',
				isTesting: false,
				testSuccess: '',
				testError: '',
				isLoggingOut: false,
				testCooldown: 0,
				testCooldownTimer: null,
				isRefreshingQR: false,

				init() {
					this.fetchStatus();
					setInterval(() => {
						this.fetchStatus();
					}, 2500);
				},

				async refreshQR() {
					this.isRefreshingQR = true;
					try {
						let res = await fetch('/settings/whatsapp/refresh-qr', { method: 'POST' });
						if (res.ok) {
							await this.fetchStatus();
						}
					} catch(e) {
						console.error('Failed to refresh QR:', e);
					} finally {
						setTimeout(() => {
							this.isRefreshingQR = false;
						}, 1000);
					}
				},

				async fetchStatus() {
					try {
						let res = await fetch('/settings/whatsapp/status');
						if (res.ok) {
							let data = await res.json();
							this.connected = data.connected;
							this.phone = data.phone;
							this.pushName = data.push_name;
							this.qrCode = data.qr_code;
							this.statusText = data.status;
						}
					} catch(e) {
						console.error('Failed to fetch WA status:', e);
					}
				},

				async logout() {
					if (!confirm('Apakah Anda yakin ingin memutuskan koneksi akun WhatsApp ini?')) return;
					this.isLoggingOut = true;
					try {
						let res = await fetch('/settings/whatsapp/logout', { method: 'POST' });
						if (res.ok) {
							await this.fetchStatus();
						}
					} catch(e) {
						alert('Gagal logout: ' + e.message);
					} finally {
						this.isLoggingOut = false;
					}
				},

				async sendTest() {
					if (this.testCooldown > 0) return;
					if (!this.testPhone) {
						alert('Harap isi nomor HP tujuan!');
						return;
					}
					this.isTesting = true;
					this.testSuccess = '';
					this.testError = '';
					try {
						let res = await fetch('/settings/whatsapp/test', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ phone: this.testPhone })
						});
						let result = await res.json();
						if (result.success) {
							this.testSuccess = 'Pesan uji coba berhasil terkirim ke WhatsApp!';
							this.testCooldown = 10;
							if (this.testCooldownTimer) clearInterval(this.testCooldownTimer);
							this.testCooldownTimer = setInterval(() => {
								this.testCooldown--;
								if (this.testCooldown <= 0) {
									clearInterval(this.testCooldownTimer);
									this.testCooldownTimer = null;
								}
							}, 1000);
						} else {
							this.testError = result.message || 'Gagal mengirim pesan.';
						}
					} catch(e) {
						this.testError = 'Kesalahan jaringan: ' + e.message;
					} finally {
						this.isTesting = false;
					}
				}
			}"
			class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6"
		>
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
				<div>
					<h1 class="text-2xl font-bold text-[#1D1D1F] tracking-tight">Integrasi WhatsApp</h1>
					<p class="text-sm text-[#8E8E93] mt-0.5">Hubungkan nomor WhatsApp toko untuk mengirim nota & invoice otomatis ke pelanggan.</p>
				</div>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-12 gap-6">
				<div class="md:col-span-7 bg-white rounded-2xl border border-[#E5E5EA] shadow-xs p-6 space-y-6">
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2.5">
							<div class="w-10 h-10 rounded-xl bg-[#25D366]/10 text-[#25D366] flex items-center justify-center">
								<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
									<path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.176.582 4.217 1.597 5.975l-1.605 5.869 6.046-1.587c1.705.938 3.665 1.473 5.751 1.473 6.627 0 12-5.373 12-12 0-6.628-5.373-12-11.789-12z"></path>
								</svg>
							</div>
							<div>
								<h2 class="text-base font-bold text-[#1D1D1F]">Status Perangkat</h2>
								<p class="text-xs text-[#8E8E93]" x-text="statusText"></p>
							</div>
						</div>
						<div>
							<template x-if="connected">
								<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green-50 text-[#34C759] border border-green-200">
									<span class="w-2 h-2 rounded-full bg-[#34C759] animate-pulse"></span>
									Terhubung
								</span>
							</template>
							<template x-if="!connected">
								<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-[#FF9500] border border-amber-200">
									<span class="w-2 h-2 rounded-full bg-[#FF9500]"></span>
									Belum Terhubung
								</span>
							</template>
						</div>
					</div>
					<template x-if="connected">
						<div class="space-y-4 pt-2">
							<div class="bg-[#F5F5F7] rounded-xl p-4 flex items-center justify-between">
								<div>
									<span class="text-xs text-[#8E8E93] block">Nomor WhatsApp Terhubung</span>
									<span class="text-lg font-bold text-[#1D1D1F] font-mono" x-text="'+' + phone"></span>
									<span class="text-xs text-[#8E8E93] block mt-0.5" x-text="pushName ? 'Nama: ' + pushName : ''"></span>
								</div>
								<div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-[#34C759]">
									<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
								</div>
							</div>
							<div class="flex gap-2">
								<button
									type="button"
									@click="logout()"
									:disabled="isLoggingOut"
									class="w-full sm:w-auto justify-center min-h-[44px] px-4 rounded-xl border border-red-200 text-xs font-semibold text-[#FF3B30] hover:bg-red-50 transition inline-flex items-center gap-1.5"
								>
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
									<span x-text="isLoggingOut ? 'Memutuskan...' : 'Putuskan Koneksi (Logout)'"></span>
								</button>
							</div>
						</div>
					</template>
					<template x-if="!connected">
						<div class="space-y-5 pt-2">
							<div class="flex flex-col items-center justify-center p-4 sm:p-6 bg-[#F5F5F7] rounded-2xl border border-dashed border-[#E5E5EA]">
								<template x-if="qrCode">
									<div class="flex flex-col items-center">
										<div class="bg-white p-3 sm:p-4 rounded-2xl shadow-sm border border-[#E5E5EA]">
											<img :src="qrCode" alt="Scan WhatsApp QR Code" class="max-w-full w-56 h-56 sm:w-64 sm:h-64 object-contain rounded-lg"/>
										</div>
										<div class="mt-3">
											<button
												type="button"
												@click="refreshQR()"
												:disabled="isRefreshingQR"
												class="inline-flex items-center gap-1.5 text-xs text-[#007AFF] hover:text-[#0066D6] font-medium transition cursor-pointer"
											>
												<svg class="w-3.5 h-3.5" :class="{ 'animate-spin': isRefreshingQR }" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
												<span x-text="isRefreshingQR ? 'Memperbarui...' : 'Muat Ulang Kode QR'"></span>
											</button>
										</div>
									</div>
								</template>
								<template x-if="!qrCode">
									<div class="w-64 h-64 flex flex-col items-center justify-center text-center p-4 space-y-3">
										<template x-if="isRefreshingQR || statusText.includes('Menyiapkan') || statusText.includes('Menunggu')">
											<div class="flex flex-col items-center justify-center space-y-2">
												<svg class="w-8 h-8 animate-spin text-[#007AFF]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
												<span class="text-xs font-medium text-[#8E8E93]" x-text="statusText || 'Memuat QR Code...'"></span>
											</div>
										</template>
										<template x-if="!isRefreshingQR && !statusText.includes('Menyiapkan') && !statusText.includes('Menunggu')">
											<div class="flex flex-col items-center justify-center space-y-3">
												<div class="w-12 h-12 rounded-full bg-amber-100 text-[#FF9500] flex items-center justify-center">
													<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
												</div>
												<div>
													<p class="text-sm font-semibold text-[#1D1D1F]">QR Code Kedaluwarsa</p>
													<p class="text-xs text-[#8E8E93] mt-0.5">Waktu scan telah habis. Klik tombol di bawah untuk membuat kode QR baru.</p>
												</div>
												<button
													type="button"
													@click="refreshQR()"
													class="min-h-[40px] px-4 rounded-xl bg-[#007AFF] text-white text-xs font-semibold hover:bg-[#0066D6] transition inline-flex items-center gap-1.5 shadow-xs cursor-pointer"
												>
													<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
													<span>Muat Ulang QR Code</span>
												</button>
											</div>
										</template>
									</div>
								</template>
								<p class="text-xs text-[#8E8E93] mt-4 text-center">
									Kode QR akan otomatis diperbarui setiap 20 detik. Scan sebelum waktu habis.
								</p>
							</div>
							<div class="space-y-2 text-xs text-gray-600 bg-blue-50/60 border border-blue-100 p-4 rounded-xl">
								<h3 class="font-bold text-[#007AFF]">Cara Menghubungkan:</h3>
								<ol class="list-decimal list-inside space-y-1 text-[#1D1D1F]">
									<li>Buka aplikasi <strong>WhatsApp</strong> di ponsel kasir/toko.</li>
									<li>Pilih menu <strong>Titik Tiga</strong> di Android atau menu <strong>Pengaturan</strong> di iPhone.</li>
									<li>Ketuk <strong>Perangkat Tertaut (*Linked Devices*)</strong>.</li>
									<li>Ketuk <strong>Tautkan Perangkat</strong>, lalu arahkan kamera ke kode QR di atas.</li>
								</ol>
							</div>
						</div>
					</template>
				</div>
				<div class="md:col-span-5 space-y-6">
					<div class="bg-white rounded-2xl border border-[#E5E5EA] shadow-xs p-6 space-y-4">
						<h3 class="font-bold text-[#1D1D1F] text-base">Uji Coba Pengiriman</h3>
						<p class="text-xs text-[#8E8E93]">Kirim pesan uji coba untuk memastikan nomor WhatsApp toko sudah aktif dan dapat mengirim pesan.</p>
						<div class="space-y-3">
							<div>
								<label class="block text-xs font-semibold text-[#1D1D1F] mb-1">Nomor HP Tujuan (Contoh: 08123456789)</label>
								<input
									type="text"
									x-model="testPhone"
									placeholder="08xxxxxxxxxx"
									class="w-full bg-[#F5F5F7] border border-transparent rounded-xl px-3 min-h-[42px] text-sm focus:bg-white focus:border-[#007AFF] outline-none tabular-nums"
								/>
							</div>
							<template x-if="testSuccess">
								<div class="p-3 bg-green-50 border border-green-200 rounded-xl text-xs text-[#34C759] font-medium" x-text="testSuccess"></div>
							</template>
							<template x-if="testError">
								<div class="p-3 bg-red-50 border border-red-200 rounded-xl text-xs text-[#FF3B30] font-medium" x-text="testError"></div>
							</template>
							<button
								type="button"
								@click="sendTest()"
								:disabled="isTesting || !connected || testCooldown > 0"
								class="w-full min-h-[44px] bg-[#007AFF] text-white rounded-xl font-semibold text-xs hover:bg-[#0066D6] disabled:opacity-50 transition shadow-xs flex items-center justify-center gap-1.5"
							>
								<svg x-show="!isTesting && testCooldown === 0" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
								<span x-text="isTesting ? 'Mengirim...' : (testCooldown > 0 ? 'Tunggu (' + testCooldown + 's)' : 'Kirim Pesan Uji Coba')"></span>
							</button>
						</div>
					</div>
					<div class="bg-white rounded-2xl border border-[#E5E5EA] shadow-xs p-6 space-y-3">
						<h3 class="font-bold text-[#1D1D1F] text-base">Pengiriman Otomatis</h3>
						<div class="space-y-2.5 text-xs text-[#8E8E93]">
							<div class="flex items-start gap-2">
								<svg class="w-4 h-4 text-[#34C759] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
								<span><strong>Nota Kasir Otomatis:</strong> Setiap transaksi yang memiliki data pelanggan dengan nomor HP akan langsung menerima nota di WhatsApp.</span>
							</div>
							<div class="flex items-start gap-2">
								<svg class="w-4 h-4 text-[#34C759] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
								<span><strong>Format Monospace:</strong> Tampilan struk menggunakan format tabel rapi yang nyaman dibaca di layar smartphone pelanggan.</span>
							</div>
							<div class="flex items-start gap-2">
								<svg class="w-4 h-4 text-[#34C759] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
								<span><strong>Pelanggan Walk-In:</strong> Kasir tetap dapat mengirim nota via tombol manual di popup selesai transaksi jika pelanggan meminta.</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
